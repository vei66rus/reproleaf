OPENAI_API_KEY=
# Enable only after the owner approves the provider, model, prices and budget.
REPROLEAF_AI_ENABLED=0
REPROLEAF_AI_MODEL=
REPROLEAF_AI_DAILY_BUDGET_USD=0
REPROLEAF_AI_INPUT_USD_PER_MILLION=0
REPROLEAF_AI_OUTPUT_USD_PER_MILLION=0
# All Node processes sharing a budget must use this same private persistent file.
REPROLEAF_AI_LEDGER_PATH=./private/ai-budget/ledger.json
REPROLEAF_PUBLIC_MCP=0
# Local stdio MCP only. Configure an HTTPS WordPress crawler endpoint and a private project token.
REPROLEAF_SITE_ENDPOINT=
REPROLEAF_SITE_PROJECT_TOKEN=
REPROLEAF_SITE_JOB_ID=
