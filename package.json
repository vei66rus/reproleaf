{
  "name": "reproleaf",
  "version": "0.7.1",
  "private": true,
  "type": "module",
  "description": "Installable agent workflows, MCP and CLI for mobile web checks and evidence-backed editorial review.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node src/build.mjs",
    "dev": "node src/cli.mjs serve",
    "cases": "node src/cli.mjs list",
    "verify": "node src/cli.mjs verify --all",
    "mcp": "node src/mcp.mjs",
    "test": "node --test tests/*.test.mjs",
    "build:browser": "node src/build-browser.mjs",
    "test:browser": "node tests/browser-regressions.mjs",
    "test:context-browser": "node tests/application-context-browser.mjs",
    "test:comparison-browser": "node tests/frontend-comparison-browser.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "marked": "18.1.3",
    "parse5": "8.1.0",
    "playwright": "1.64.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "esbuild": "0.28.2",
    "phaser": "3.90.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0",
    "vue": "3.5.45"
  },
  "license": "MIT"
}
