{
  "name": "reproleaf",
  "version": "2.3.1",
  "mcpName": "io.github.vei66rus/reproleaf",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "reproleaf": "./src/cli.mjs",
    "reproleaf-mcp": "./src/mcp.mjs"
  },
  "description": "Deterministic SEO, GEO, HTML, Schema.org, OpenGraph, AI crawler, and mobile UI verification MCP server and CLI.",
  "keywords": [
    "seo",
    "geo",
    "llms-txt",
    "mcp",
    "mcp-server",
    "technical-seo",
    "json-ld",
    "robots-txt",
    "ai-search",
    "accessibility"
  ],
  "homepage": "https://evolkov.tech/tools/reproleaf",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vei66rus/reproleaf.git"
  },
  "bugs": {
    "url": "https://github.com/vei66rus/reproleaf/issues"
  },
  "files": [
    "src/",
    "badges/",
    "examples/",
    "cases/",
    "fixtures/",
    "packs/",
    "skills/",
    "server.json",
    "benchmarks/pilot-dataset.json",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node src/build.mjs",
    "dev": "node src/cli.mjs serve",
    "cases": "node src/cli.mjs list",
    "verify": "node src/cli.mjs verify --all",
    "mcp": "node src/mcp.mjs",
    "test": "node --test tests/*.test.mjs",
    "build:browser": "node src/build-browser.mjs",
    "build:wordpress": "node src/build-browser.mjs integrations/wordpress/reproleaf/workspace",
    "test:browser": "node tests/browser-regressions.mjs",
    "test:context-browser": "node tests/application-context-browser.mjs",
    "test:comparison-browser": "node tests/frontend-comparison-browser.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "axe-core": "4.14.0",
    "marked": "18.1.3",
    "parse5": "8.1.0",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "playwright": "^1.50.0"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "esbuild": "0.28.2",
    "phaser": "3.90.0",
    "playwright": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0",
    "vue": "3.5.45"
  },
  "license": "MIT"
}
