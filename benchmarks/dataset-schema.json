{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reproleaf GEO & AI Readiness Benchmark Dataset",
  "type": "object",
  "required": ["ok", "sha256", "generatedAt", "summary", "results"],
  "properties": {
    "ok": { "type": "boolean" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "summary": {
      "type": "object",
      "required": [
        "methodology",
        "userAgent",
        "totalOrigins",
        "reachableCount",
        "skippedByRobotsCount",
        "validLlmsTxtCount",
        "jsonLdAdoptedCount",
        "oaiSearchAllowedCount",
        "perplexityAllowedCount",
        "gptBotBlockedCount"
      ]
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "origin",
          "retrievedAt",
          "status",
          "permissionLog",
          "homeStatus",
          "wordCount",
          "jsonLdTypes",
          "llmsTxtStatus",
          "llmsTxtValid",
          "aiBots",
          "score"
        ]
      }
    }
  }
}
