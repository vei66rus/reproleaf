{
  "name": "reproleaf-seo-linter",
  "displayName": "Reproleaf SEO & GEO Linter",
  "description": "Real-time HTML, Markdown, llms.txt, JSON-LD, E-E-A-T, RAG, Answer-First and Quick-Fix diagnostics.",
  "version": "1.1.0",
  "publisher": "vei66rus",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Linters"
  ],
  "activationEvents": [
    "onLanguage:html",
    "onLanguage:markdown",
    "onLanguage:plaintext",
    "workspaceContains:**/llms.txt"
  ],
  "main": "./extension.mjs",
  "contributes": {
    "commands": [
      {
        "command": "reproleaf.auditActiveFile",
        "title": "Reproleaf: Audit Active File"
      }
    ]
  }
}
